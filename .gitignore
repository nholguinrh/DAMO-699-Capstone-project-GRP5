proposal_rubric_analysis.md

# Python
__pycache__/
*.pyc
*.pyo

# Jupyter checkpoint dirs
**/.ipynb_checkpoints/

# Environment secrets (each teammate creates their own — see .env.example)
.env

# Local reference PDFs (not a tracked deliverable)
docs/Biblio/

# Raw and processed data (regenerated by the pipeline — see data/README.md)
data/raw/*
!data/raw/.gitkeep
# Issue #109: the raw pulls that seed config/statcan_cpi_archive.csv are the
# only provenance for reference months StatCan's rolling window no longer
# returns on a fresh pull. They must be reviewable/reproducible from the
# repo, so they're exempt from the data/raw ignore above.
!data/raw/statcan/
!data/raw/statcan/cpi_*.json
data/processed/*
!data/processed/.gitkeep

# Dashboard pipeline-trigger run summary (per-run, machine-local)
outputs/pipeline_run_status.json

# Local PR code review and validation documents (not tracked deliverables)
docs/PR_*_CODE_REVIEW*.md
docs/PR_*_VALIDATION*.md
